# Here we set a bunch of parameters for your image build

# output image name, usually same as repo name, change as needed
IMAGE_NAME=aerocore-os

# Make this the same as your github username/organisation
REPO_ORGANIZATION="AeroCore-IO"

IMAGE_DESC="AeroCore customized Bazzite Deck image"
IMAGE_KEYWORDS="bootc,oci,linux,bazzite,steam-deck,aerocore"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"

# Keep this on bazzite-deck for Steam Deck, game mode, and handheld customizations.
# Use a concrete tag during transition windows if stable/testing moves underneath you.
BASE_IMAGE="ghcr.io/ublue-os/bazzite-deck:stable"

# Optional mirror settings.
FLATPAK_REMOTE_URL=""
HOMEBREW_BOTTLE_DOMAIN=""
HOMEBREW_API_DOMAIN=""

# AeroCore Booster release embedded into the image. Use a concrete tag for
# reproducible production builds, or "latest" for rolling development images.
INSTRUMENTS_ENABLED="true"
INSTRUMENTS_RELEASE_REPOSITORY="AeroCore-IO/booster-installer"
INSTRUMENTS_VERSION="latest"
INSTRUMENTS_RELEASE_API_BASE="https://api.github.com"
