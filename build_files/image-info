#!/usr/bin/bash

set -eoux pipefail

IMAGE_PRETTY_NAME="AeroCore OS"
IMAGE_ID="aerocore"
IMAGE_LIKE="fedora"
HOME_URL="https://os.aerocore.com.cn"
DOCUMENTATION_URL="https://docs.os.aerocore.com.cn"
SUPPORT_URL="https://os.aerocore.com.cn/support"
BUG_SUPPORT_URL="https://github.com/AeroCore-IO/AeroCore-OS/issues/"
LOGO_ICON="distributor-logo"
LOGO_COLOR="0;38;2;12;109;129"

IMAGE_INFO="/usr/share/ublue-os/image-info.json"
OSTREE_REGISTRY="${OSTREE_REGISTRY:-docker://ghcr.io}"
OSTREE_NAMESPACE="${OSTREE_NAMESPACE:-$IMAGE_VENDOR}"
IMAGE_REF="${OSTREE_IMAGE_REF:-ostree-image-signed:${OSTREE_REGISTRY%/}/$OSTREE_NAMESPACE/$IMAGE_NAME}"
IMAGE_BRANCH_NORMALIZED="$IMAGE_BRANCH"
BASE_IMAGE_NAME=$(jq -er '."base-image-name"' < "$IMAGE_INFO")

if [[ $IMAGE_BRANCH_NORMALIZED == "main" ]]; then
  IMAGE_BRANCH_NORMALIZED="stable"
fi

FEDORA_VERSION=$(rpm -E %fedora)

mkdir -p "$(dirname "$IMAGE_INFO")"
cat > "$IMAGE_INFO" <<EOF
{
  "image-name": "$IMAGE_NAME",
  "image-vendor": "$IMAGE_VENDOR",
  "image-ref": "$IMAGE_REF",
  "image-tag": "$IMAGE_BRANCH_NORMALIZED",
  "image-branch": "$IMAGE_BRANCH_NORMALIZED",
  "base-image-name": "$BASE_IMAGE_NAME",
  "fedora-version": "$FEDORA_VERSION",
  "version": "$VERSION_TAG",
  "version-pretty": "$VERSION_PRETTY"
}
EOF

# Fail the image build if the metadata file was not rewritten with the
# downstream identity.  A base Bazzite image can otherwise leave a plausible
# looking build with image-info.json still claiming bazzite-deck.
if [[ "$IMAGE_NAME" != "aerocore-os" || "$IMAGE_VENDOR" != "aerocore-io" ]]; then
  echo "Unexpected AeroCore image identity: ${IMAGE_VENDOR}/${IMAGE_NAME}" >&2
  exit 1
fi

jq -e \
  --arg image_name "$IMAGE_NAME" \
  --arg image_vendor "$IMAGE_VENDOR" \
  '.["image-name"] == $image_name and .["image-vendor"] == $image_vendor and .["image-ref"] != null' \
  "$IMAGE_INFO" >/dev/null

# Keep the display name consistent across desktop settings and os-release.
sed -i "s/^VARIANT_ID=.*/VARIANT_ID=$IMAGE_ID/" /usr/lib/os-release
sed -i "s/^PRETTY_NAME=.*/PRETTY_NAME=\"$IMAGE_PRETTY_NAME\"/" /usr/lib/os-release
sed -i "s/^NAME=.*/NAME=\"$IMAGE_PRETTY_NAME\"/" /usr/lib/os-release
sed -i "s|^HOME_URL=.*|HOME_URL=\"$HOME_URL\"|" /usr/lib/os-release
sed -i "s|^DOCUMENTATION_URL=.*|DOCUMENTATION_URL=\"$DOCUMENTATION_URL\"|" /usr/lib/os-release
sed -i "s|^SUPPORT_URL=.*|SUPPORT_URL=\"$SUPPORT_URL\"|" /usr/lib/os-release
sed -i "s|^BUG_REPORT_URL=.*|BUG_REPORT_URL=\"$BUG_SUPPORT_URL\"|" /usr/lib/os-release
sed -i "s|^CPE_NAME=.*|CPE_NAME=\"cpe:/o:universal-blue:$IMAGE_ID\"|" /usr/lib/os-release
sed -i "s/^DEFAULT_HOSTNAME=.*/DEFAULT_HOSTNAME=\"$IMAGE_NAME\"/" /usr/lib/os-release
sed -i "s/^ID=fedora/ID=$IMAGE_ID\nID_LIKE=\"$IMAGE_LIKE\"/" /usr/lib/os-release
sed -i "s/^LOGO=.*/LOGO=$LOGO_ICON/" /usr/lib/os-release
sed -i "s/^ANSI_COLOR=.*/ANSI_COLOR=\"$LOGO_COLOR\"/" /usr/lib/os-release
sed -i "/^REDHAT_BUGZILLA_PRODUCT=/d; /^REDHAT_BUGZILLA_PRODUCT_VERSION=/d; /^REDHAT_SUPPORT_PRODUCT=/d; /^REDHAT_SUPPORT_PRODUCT_VERSION=/d" /usr/lib/os-release
sed -i "s|^VERSION_CODENAME=.*|VERSION_CODENAME=\"Deck\"|" /usr/lib/os-release

# /etc/system-release is normally a symlink to the RPM-owned fedora-release.
# Replace the directory entry instead of writing through that link.  In the
# bootc/ostree build chain, an in-place write to the RPM-owned target can be
# lost while the final image is assembled, leaving Anaconda to read the
# upstream file (which may contain a trailing NUL).
SYSTEM_RELEASE="/etc/system-release"
EXPECTED_SYSTEM_RELEASE="$IMAGE_PRETTY_NAME release $FEDORA_VERSION (Deck)"
rm -f -- "$SYSTEM_RELEASE"
printf '%s\n' "$EXPECTED_SYSTEM_RELEASE" > "$SYSTEM_RELEASE"
SYSTEM_RELEASE_TARGET="$SYSTEM_RELEASE"

if ! cmp -s <(printf '%s\n' "$EXPECTED_SYSTEM_RELEASE") "$SYSTEM_RELEASE_TARGET"; then
  echo "Failed to write a clean AeroCore system-release to ${SYSTEM_RELEASE_TARGET}" >&2
  od -An -v -tx1 "$SYSTEM_RELEASE_TARGET" >&2
  exit 1
fi

if grep -q '^BUILD_ID=' /usr/lib/os-release; then
  sed -i "s/^BUILD_ID=.*/BUILD_ID=\"$VERSION_PRETTY\"/" /usr/lib/os-release
else
  echo "BUILD_ID=\"$VERSION_PRETTY\"" >> /usr/lib/os-release
fi

if grep -q '^BOOTLOADER_NAME=' /usr/lib/os-release; then
  sed -i "s/^BOOTLOADER_NAME=.*/BOOTLOADER_NAME=\"$IMAGE_PRETTY_NAME $VERSION_PRETTY\"/" /usr/lib/os-release
else
  echo "BOOTLOADER_NAME=\"$IMAGE_PRETTY_NAME $VERSION_PRETTY\"" >> /usr/lib/os-release
fi

# Keep hibernation images tied to this exact image version.
if grep -q '^IMAGE_ID=' /usr/lib/os-release; then
  sed -i "s/^IMAGE_ID=.*/IMAGE_ID=\"$IMAGE_NAME-$VERSION_TAG\"/" /usr/lib/os-release
else
  echo "IMAGE_ID=\"$IMAGE_NAME-$VERSION_TAG\"" >> /usr/lib/os-release
fi
